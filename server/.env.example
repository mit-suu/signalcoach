# ─────────────────────────────────────────────────────────────
# SignalCoach API — environment variables
# Copy to .env for local dev:   cp .env.example .env
# On Azure App Service set these under
#   Settings → Environment variables → App settings
# (never commit a real .env). Validated at boot in src/config/env.ts —
# the server refuses to start if anything required is missing/invalid.
# ─────────────────────────────────────────────────────────────

# development | test | production
NODE_ENV=development
# Azure injects PORT automatically; keep 4000 locally.
PORT=4000
# pino level: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# ── MongoDB ─────────────────────────────────────────────────
# Local (docker compose up -d mongo):
MONGODB_URI=mongodb://localhost:27017
# Atlas (Azure): mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=signalcoach

# ── Auth (access token only, no refresh token) ──────────────
# >= 32 random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Lifetime of the access token after register/login (vercel/ms format: 15m, 12h, 7d)
JWT_EXPIRES_IN=7d
# Lifetime of the anonymous-visitor token (keeps practice history in this browser, FR-11/12)
ANON_TOKEN_EXPIRES_IN=180d
COOKIE_NAME=sc_token
# true in production (HTTPS). false only for http://localhost.
COOKIE_SECURE=false
# lax  → browser calls the API through the Next.js /api rewrite (same origin) — default.
# none → browser calls the API host directly (cross-site); requires COOKIE_SECURE=true.
COOKIE_SAMESITE=lax

# ── HTTP ────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API directly (CORS).
# Empty = CORS off (fine when every call goes through the Next.js rewrite).
CORS_ORIGINS=http://localhost:3000
# Number of reverse proxies in front of the app (Azure front end = 1). 0 locally.
TRUST_PROXY=0

# ── LLM ────────────────────────────────────────────────────
# mock              → canned offline replies (tests, UI work without a key)
# gemini            → Google Gemini API (default for the demo)
# openai_compatible → any OpenAI-style /v1 endpoint (self-hosted model)
LLM_PROVIDER=gemini
# One or more Gemini API keys, comma-separated. When the first is rejected or out of quota
# (401/403/429) the next one is used automatically — a backup key keeps a demo alive.
GEMINI_API_KEYS=
# Model per agent role. Leave empty for the Gemini defaults:
#   persona gemini-3.5-flash · judge gemini-3.5-flash-lite (fast, on the 3s budget) · review gemini-3.8-flash
LLM_MODEL_PERSONA=
LLM_MODEL_JUDGE=
LLM_MODEL_REVIEW=
# Tried in order when a model is overloaded (503). Default: gemini-3.5-flash,gemini-3.5-flash-lite
LLM_MODEL_FALLBACKS=
# Thinking effort per role: none | low | medium | high (empty = provider default).
LLM_REASONING_PERSONA=low
LLM_REASONING_JUDGE=low
LLM_REASONING_REVIEW=high
LLM_TIMEOUT_MS=60000
# openai_compatible only
LLM_BASE_URL=
LLM_API_KEY=
