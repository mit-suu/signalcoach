# ─────────────────────────────────────────────────────────────
# SignalCoach web — environment variables
# Local:  cp .env.example .env.local
# Vercel: Project → Settings → Environment Variables (Production + Preview)
# Only NEXT_PUBLIC_* values reach the browser; never put secrets there.
# ─────────────────────────────────────────────────────────────

# Origin of the Express API that /api/* is proxied to (no trailing slash, no /api).
# Read at BUILD time by next.config.ts — redeploy after changing it on Vercel.
#   local: http://localhost:4000
#   prod : https://<your-app>.azurewebsites.net
API_ORIGIN=http://localhost:4000
